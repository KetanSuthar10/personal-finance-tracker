# Documentation only: M1 should run with synthetic data and no credentials.
# Create .env.local only once the implementing milestone defines its config.
VITE_DATA_MODE=demo

# Public frontend configuration for a future connected milestone:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend secrets must be configured in Supabase Edge Function secrets,
# not in a frontend .env file and never using a VITE_ prefix:
# GEMINI_API_KEY
# GEMINI_MODEL
# No live values are included in this starter.
