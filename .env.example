# Personal Finance Tracker — Environment Configuration
# Copy this file to .env.local for local development.
# In Vercel, configure these variables in Project Settings -> Environment Variables.

# 1. Supabase Project Configuration (Required for connected cloud mode)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Canonical publishable key:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backwards compatibility alias (optional if VITE_SUPABASE_PUBLISHABLE_KEY is set):
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# 2. Application Data Mode
# Options: 'cloud' (authenticated Supabase cloud storage) or 'demo' (isolated synthetic data)
VITE_DATA_MODE=cloud

# ==============================================================================
# PRIVILEGE & SECURITY WARNING
# ==============================================================================
# - NEVER put service_role keys, database passwords, or JWT secrets in this file.
# - NEVER prefix privileged credentials with VITE_.
# - Backend secrets (e.g. GEMINI_API_KEY) belong exclusively in Supabase Edge
#   Function secrets / Vault, never in client frontend bundles.
# ==============================================================================
